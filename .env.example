# Providers are tried in order: watsonx → OpenAI → OpenRouter. The first one that
# answers is used, so a dead or unconfigured provider degrades to the next instead
# of failing. Configure only the one(s) you have.

WATSONX_API_KEY=...
WATSONX_PROJECT_ID=...
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=gpt-oss-120b

# OpenAI, called directly at api.openai.com. Needs an OpenAI platform key
# (sk-proj-... / sk-...) — an OpenRouter key will NOT authenticate here.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OpenRouter. Needs an OpenRouter key (sk-or-v1-...), not an OpenAI one.
# OPENROUTER_MODEL takes any id from https://openrouter.ai/models. Prefer a
# non-reasoning model: reasoning models spend most of their completion budget on
# hidden reasoning_content, which makes enrichment slow without improving the
# summaries, and `:free` models are queued behind paid traffic.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
